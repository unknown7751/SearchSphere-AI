# Optional overrides; no secrets are required and the defaults work as-is.
# The backend reads REAL ENVIRONMENT VARIABLES - it does not load a .env file. Set them in the shell before
# starting uvicorn, e.g. PowerShell:  $env:SEARCHSPHERE_CORS_ORIGINS = "http://localhost:3000,http://127.0.0.1:3000"
# (Uncomment-and-copy is only a convenient place to keep the names and defaults.)
# SEARCHSPHERE_DB_PATH=data/searchsphere.db
# SEARCHSPHERE_NLTK_DIR=data/nltk_data
# SEARCHSPHERE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# SEARCHSPHERE_WILDCARD_LIMIT=50
# SEARCHSPHERE_MAX_UPLOAD_BYTES=5242880
# SEARCHSPHERE_MAX_DOCUMENT_CHARS=200000
# Crawler (Phase 3). Per-job limits (max_pages <= 100, max_depth <= 5, timeout <= 30 s) cannot be raised here.
# SEARCHSPHERE_CRAWLER_USER_AGENT=SearchSphereBot/1.0 (+educational IR project; honours robots.txt)
# SEARCHSPHERE_CRAWLER_DELAY=0.5
# SEARCHSPHERE_CRAWLER_MAX_BYTES=2097152
# SEARCHSPHERE_CRAWLER_MAX_REDIRECTS=5
# SEARCHSPHERE_CRAWLER_MAX_DURATION=300
# SEARCHSPHERE_CRAWLER_MAX_DISCOVERED=1000
